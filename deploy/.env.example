# .env da VPS (não commitar). Copie para .env e preencha.

POSTGRES_DB=beira_linha_play
POSTGRES_USER=beira
POSTGRES_PASSWORD=troque-esta-senha

# Origem pública do browser (HTTP no IP agora; HTTPS quando houver domínio).
APP_ALLOWED_HOSTS=http://SEU_IP_PUBLICO

# HTTP: false. HTTPS: true.
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# openssl rand -base64 64
JWT_SECRET=altere-este-segredo-em-base64

GEMINI_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=medalhas

SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# O Compose já define SPRING_PROFILES_ACTIVE=prod (sem SQL/debug no log).

# Só no overlay HTTPS (docker-compose.https.yml):
# APP_DOMAIN=app.seudominio.com
