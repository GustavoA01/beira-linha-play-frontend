# URL absoluta da API (Vercel → Railway). Vazio = mesma origem /api
# (Vite proxy no `npm run dev`, nginx no Docker). No celular, deixe vazio
# e abra http://SEU_IP:5173 — não use localhost no aparelho.
# Imagem de produção (docker-compose.build.yml): VITE_API_URL fica vazio.
VITE_API_URL=http://localhost:8080
