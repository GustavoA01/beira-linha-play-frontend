@startuml Diagrama_de_classes_Beira_Linha
title Diagrama de classes — Beira Linha Play
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
hide circle

enum TipoUsuario {
  ALUNO
  MONITOR
  ADMIN
}

class Usuario {
  - id: string
  - nome: string
  - senha: string
  - tipo: TipoUsuario
  - cursoIds: string[]
}

class Aluno {
  - apelido: string
  - pontos: int
  - imagemPerfil: string
}

class Monitor

class Admin

class Medalha {
  - id: string
  - nome: string
  - imagemUrl: string
  - pontosMin: int
}

class Curso {
  - id: string
  - nome: string
  - codigoAcesso: string
  - monitorIds: string[]
}

class Modulo {
  - id: string
  - nome: string
}

class Atividade {
  - id: string
  - titulo: string
  - quantQuestoes: int
}

class Questao {
  - id: string
  - enunciado: string
  - valor: int
}

class Alternativa {
  - id: string
  - descricao: string
  - correta: boolean
}

class Tentativa {
  - id: string
  - dataEnvio: Date
  - pontuacaoObtida: int
}

class Resposta {
  - id: string
  - correta: boolean
}

Usuario <|-- Aluno
Usuario <|-- Monitor
Usuario <|-- Admin
Usuario --> TipoUsuario

Usuario "0..*" -- "0..*" Curso : inscrito
Monitor "1" -- "0..*" Curso : ministra

Curso "1" *-- "0..*" Modulo
Modulo "1" *-- "0..*" Atividade
Atividade "1" *-- "1..*" Questao
Questao "1" *-- "2..4" Alternativa

Aluno "1" -- "0..2" Tentativa : por atividade
Atividade "1" -- "0..*" Tentativa
Tentativa "1" *-- "1..*" Resposta
Resposta "0..*" --> "1" Questao
Resposta "0..*" --> "1" Alternativa : escolhida

note right of Medalha
  Catálogo global. O aluno conquista
  se pontos >= pontosMin (derivado
  na leitura, não persistido no Aluno).
end note

note right of Tentativa
  Depende de 1 Aluno e 1 Atividade
  para existir (associação obrigatória).
  Não é composição dos dois: o losango
  preto só pode ter um dono.
  No máximo 2 tentativas do mesmo
  aluno na mesma atividade.
end note

note right of Resposta
  Alternativa marcada em cada questão.
  Permite ver dificuldade e o que cada um escolheu.
end note

@enduml
